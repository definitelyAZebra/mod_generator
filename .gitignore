# =============================================================================
# .gitignore - Stoneshard Mod Generator
# =============================================================================

# === 游戏数据目录 (大型，不入库) ===
game_code/
game_data/
objects/
references/

# === 资源文件 (字体/图标由用户本地准备) ===
fonts/
icons/
*.ttf
*.otf

# === 自动生成的 UI 文件 (可由 scripts/ 重新生成) ===
ui/tw.py
ui/font_config.py
.font_metrics_cache.json

# === Node.js (TypeSpec toolchain) ===
node_modules/
package-lock.json

# === Python ===
__pycache__/
*.pyc
*.pyo
venv/
.env
.venv/

# === 构建产物 ===
build/
dist/
*.spec

# === IDE / 编辑器 ===
.vscode/
.idea/
*.swp
*.swo

# === 项目配置 (用户本地) ===
config.json
scripts/config_local.py
paths.json
pyrightconfig.json

# === UMT Scripts 输出 (脚本本身保留) ===
umt_scripts/*.json
!umt_scripts/config.example.json

# === 临时/生成文件 ===
diff_output.txt
*.json.bak
imgui.ini

# === 文档 (个人笔记) ===
*.docx
TODO_*.md
大篷车*.md
o_Dead_March.txt

# === 压缩包 ===
*.7z
*.zip

# === Datamine (下载的工具 + 提取产物 + 游戏数据) ===
datamine/vendor/
datamine/output/
datamine/input/
datamine/acquire/input/
datamine/decompile/output/
*.log

# === gml_analyzer (.NET F# 项目构建产物 + 提取输出) ===
datamine/gml_analyzer/bin/
datamine/gml_analyzer/obj/
datamine/gml_analyzer/output/

# === F# emit 管线 (StonesModEmit 构建产物) ===
emit/StonesModEmit/bin/
emit/StonesModEmit/obj/

# === TypeSpec (生成输出 + 构建缓存) ===
typespec/tsp-output/
typespec/fsharp-emitter/tsconfig.tsbuildinfo

# === Datamine notes (生成的 HTML，源 .md 保留) ===
datamine/notes/*.html

# === 测试 fixtures (真实项目数据，体积较大) ===
tests/fixtures/

# === 废弃/归档 ===
_archive/
tools/

# === AI Agent ===
.agent/

# === GitHub (本地配置) ===
.github/

.fake
